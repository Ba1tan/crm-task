meta {
  name: Overlap, same company, other manager (409)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/meetings
  body: json
  auth: none
}

body:json {
  {
    "companyId": {{companyId}},
    "managerId": {{manager2Id}},
    "startAt": "{{errDay}}T05:30:00Z"
  }
}

assert {
  res.status: eq 409
}
